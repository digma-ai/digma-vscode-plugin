{
  "name": "digma",
  "displayName": "Digma Continuous Feedback",
  "description": "Code insights and Observability for OpenTelemetry. .NET, Python, more coming soon.",
  "version": "0.5.48",
  "publisher": "digma",
  "icon": "digma.png",
  "engines": {
    "vscode": "^1.94.0"
  },
  "keywords": [
    "OpenTelemetry",
    "Observability",
    "IntelliSense",
    "IntelliCode",
    "Flask",
    "FastAPI",
    "ASP.NET",
    "C#",
    "eBPF",
    "Jaeger",
    "Python",
    "dotnet",
    "Continuous Delivery",
    "DevOps"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/digma-ai/digma?style=social",
      "description": "Star Digma on GitHub",
      "href": "bit.ly/36LyUcr"
    },
    {
      "url": "https://img.shields.io/twitter/follow/doppleware?style=social",
      "description": "Follow us on Twitter",
      "href": "bit.ly/3reNG2z"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/digma.digma?logo=visual-studio-code&style=social",
      "description": "Rate us in VSCode Marketplace",
      "href": "bit.ly/36Lzird"
    },
    {
      "url": "https://img.shields.io/youtube/views/MnJIyVVqPDU?style=social",
      "description": "Watch a Digma demo video",
      "href": "bit.ly/379pVli"
    },
    {
      "url": "https://img.shields.io/badge/Blog-black?style=flat&logo=medium&logoColor=white&link=https://medium.com/@roni-dover",
      "description": "Read Digma blog",
      "href": "https://medium.com/@roni-dover"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/digma-ai/digma-vscode-plugin"
  },
  "bugs": {
    "url": "https://github.com/digma-ai/digma-vscode-plugin/issues"
  },
  "homepage": "https://github.com/digma-ai/digma-vscode-plugin",
  "categories": [
    "Programming Languages",
    "Visualization",
    "Linters",
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "properties": {
        "digma.apiUrl": {
          "type": "string",
          "default": "https://localhost:5051",
          "description": "Digma API URL"
        },
        "digma.apiToken": {
          "type": "string",
          "default": "",
          "description": "Digma API token"
        },
        "digma.login": {
          "type": "string",
          "description": "Digma user login"
        },
        "digma.password": {
          "type": "string",
          "description": "Digma user password"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "rimraf ./out",
    "build": "tsc",
    "watch": "tsc -w -p ./tsconfig.dev.json",
    "lint": "eslint --cache .",
    "fix:prettier": "prettier --write './**/*.{json,md,ts}'",
    "precommit": "lint-staged",
    "prepare": "husky",
    "package": "vsce package"
  },
  "lint-staged": {
    "*.{json,ts}": [
      "eslint --cache"
    ],
    "*.{json,md,ts}": [
      "prettier --write"
    ]
  },
  "__metadata": {
    "id": "2e214876-5bea-4ee6-8026-222de5313d92",
    "publisherDisplayName": "Digma",
    "publisherId": "caa21fe0-eb8b-43fd-9197-ae8fb8b1b5df",
    "isPreReleaseVersion": false
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.3",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "path-to-regexp": "^8.2.0"
  }
}
